{
  "name": "@subroh0508/marp-theme-canvas",
  "version": "0.0.8",
  "description": "A simple Marp theme with minimal styling",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subroh0508/marp-theme-canvas.git"
  },
  "homepage": "https://github.com/subroh0508/marp-theme-canvas#readme",
  "bugs": {
    "url": "https://github.com/subroh0508/marp-theme-canvas/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sass": "./scss/canvas/_index.scss",
  "exports": {
    ".": {
      "sass": "./scss/canvas/_index.scss"
    },
    "./white-canvas": {
      "sass": "./scss/white-canvas.scss",
      "style": "./css/white-canvas.css"
    },
    "./black-canvas": {
      "sass": "./scss/black-canvas.scss",
      "style": "./css/black-canvas.css"
    },
    "./canvas": {
      "sass": "./scss/canvas/_index.scss"
    },
    "./canvas/*": {
      "sass": "./scss/canvas/*"
    },
    "./canvas/token/*": {
      "sass": "./scss/canvas/token/*"
    },
    "./canvas/element/*": {
      "sass": "./scss/canvas/element/*"
    },
    "./canvas/element/prettylights/*": {
      "sass": "./scss/canvas/element/prettylights/*"
    },
    "./canvas/component/*": {
      "sass": "./scss/canvas/component/*"
    },
    "./canvas/pattern/*": {
      "sass": "./scss/canvas/pattern/*"
    },
    "./white-canvas.css": "./css/white-canvas.css",
    "./black-canvas.css": "./css/black-canvas.css",
    "./white-canvas/*.css": "./css/white-canvas/*.css",
    "./black-canvas/*.css": "./css/black-canvas/*.css",
    "./white-canvas/*/*.css": "./css/white-canvas/*/*.css",
    "./black-canvas/*/*.css": "./css/black-canvas/*/*.css"
  },
  "files": [
    "css",
    "scss",
    "LICENSE"
  ],
  "scripts": {
    "serve": "marp --allow-local-files --html -s demo",
    "build": "find scss -name '[!_]*.scss' -type f | while read f; do out=\"css/${f#scss/}\"; out=\"${out%.scss}.css\"; mkdir -p \"$(dirname \"$out\")\"; sass --no-source-map \"$f\" \"$out\"; done",
    "build:demo": "marp --allow-local-files --html --input-dir demo --output public"
  },
  "keywords": [
    "marp",
    "marp-theme",
    "slide",
    "presentation"
  ],
  "author": {
    "name": "Subroh Nishikori",
    "email": "subroh.0508@gmail.com"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.28.1",
  "devDependencies": {
    "@marp-team/marp-cli": "^4.2.3",
    "sass": "^1.97.2"
  }
}
